{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "echo 'Static site — no build needed'",
  "installCommand": "echo 'No install needed — serverless function uses native fetch only'",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/wk2-data", "destination": "/api/wk2-data" },
    { "source": "/api/wk2-data", "destination": "/api/wk2-data" },
    { "source": "/api/(.*)", "destination": "https://workspaceapi-server-production-9087.up.railway.app/api/$1" },
    { "source": "/((?!api/|login|login.html|static/|public/|imgtest.html|favicon.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(index.html|login.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
