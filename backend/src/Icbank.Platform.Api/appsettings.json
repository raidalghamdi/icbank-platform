{
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "icbank-platform",
    "Audience": "icbank-platform-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8
  },
  "AzureAd": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "AllowedDomain": "",
    "RedirectUri": "",
    "AllowedRedirectTargets": []
  },
  "Cron": {
    "ApiKey": ""
  },
  "Seed": {
    "AllowInProduction": false,
    "InitialSuperAdminEmail": "",
    "InitialSuperAdminPassword": ""
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext", "WithExceptionDetails"]
  },
  "AllowedHosts": "*"
}
