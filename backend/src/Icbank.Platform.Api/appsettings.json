    "Audience": "icbank-platform-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8
  },
  "DownloadTokens": {
    "SigningKey": "",
    "LifetimeSeconds": 120
  },
  "AzureAd": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
