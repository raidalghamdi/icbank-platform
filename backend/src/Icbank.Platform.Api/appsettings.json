    "RedirectUri": "",
    "AllowedRedirectTargets": []
  },
  "Cron": {
    "ApiKey": ""
  },
  "Seed": {
    "AllowInProduction": false,
    "InitialSuperAdminEmail": "ccteam234@gmail.com",
    "InitialSuperAdminPassword": ""
  },
  "KeyVault": {
    "VaultUri": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "ObjectStorage": {
    "Provider": "FileSystem",
    "RootPath": "App_Data/storage",
    "UploadUrlBase": "https://storage.local/upload",
    "AzureBlob": {
      "ServiceUri": "",
      "AccountName": "",
      "UploadUrlLifetimeMinutes": 15
