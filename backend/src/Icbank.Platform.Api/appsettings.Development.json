{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=IcbankPlatformDev;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:5173"]
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-not-for-production-use-minimum-32-bytes"
  },
  "DownloadTokens": {
    "SigningKey": "dev-only-download-token-key-not-for-production-use-32-bytes"
  },
  "AzureAd": {
    "AllowedRedirectTargets": ["http://localhost:4200/auth/callback", "http://localhost:5173/auth/callback"]
  },
  "Cron": {
    "ApiKey": "dev-only-cron-key"
  },
  "Seed": {
    "AllowInProduction": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
