root = true

[*.cs]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

# R-BE-010 — PascalCase types/methods, camelCase locals
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, method, property
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.locals_camel.severity = warning
dotnet_naming_rule.locals_camel.symbols = locals
dotnet_naming_rule.locals_camel.style = camel_case
dotnet_naming_symbols.locals.applicable_kinds = local, parameter
dotnet_naming_style.camel_case.capitalization = camel_case

# R-BE-093 — var only when type is obvious
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning

# R-BE-096 — prefer records for immutable data (advisory, SHOULD not MUST)
csharp_style_prefer_top_level_statements = false:suggestion

# R-BE-091 — method length ceiling (Roslynator RCS1xxx maps length smell to warning; hard 40-line
# gate is enforced by a custom CI script, see backend/README.md, because Roslyn has no native LOC rule)
dotnet_diagnostic.RCS1004.severity = warning

# R-BE-095 — no magic numbers
dotnet_diagnostic.RCS1054.severity = warning
dotnet_diagnostic.CA1802.severity = warning

# Nullable / warnings-as-errors reinforcement
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8618.severity = error

# Empty catch blocks forbidden — R-BE-051
dotnet_diagnostic.CA1031.severity = warning

# Async suffix — R-BE-014
dotnet_diagnostic.VSTHRD200.severity = silent

# StyleCop noise not part of this contract's enforcement surface — silenced deliberately.
# Why: SA1600-family (documentation) is superseded by the explicit CS1591 carve-out in
# Directory.Build.props; SA1101/SA1309 conflict with idiomatic modern C# (this., underscore fields).
dotnet_diagnostic.SA1101.severity = silent
dotnet_diagnostic.SA1309.severity = silent
dotnet_diagnostic.SA1600.severity = silent
dotnet_diagnostic.SA1601.severity = silent
dotnet_diagnostic.SA1602.severity = silent
dotnet_diagnostic.SA1633.severity = silent
dotnet_diagnostic.SA1652.severity = silent

[*.{yml,yaml,json}]
indent_size = 2

[*.sql]
indent_size = 2
