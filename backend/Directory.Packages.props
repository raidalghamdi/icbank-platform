<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core / SQL Server — pinned to latest 8.0.x patch as of Aug 2026.
         Deviation: conventions doc says 8.0.16; 8.0.29 is the latest 8.0.x patch available today.
         See SCAFFOLD-NOTES.md. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.29" />

    <!-- FluentValidation — pinned to 11.x per contract (do NOT upgrade to 12.x without sign-off). -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />

    <!-- MediatR — pinned to 12.x per contract (13.x+ is dual-licensed, see §8 of conventions doc). -->
    <PackageVersion Include="MediatR" Version="12.4.1" />

    <!-- Serilog -->
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="8.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />

    <!-- API docs / versioning -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />

    <!-- Resilience (Polly v8 wrapper) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />

    <!-- Auth -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.2.0" />

    <!-- Health checks -->
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.2" />

    <!-- Background jobs -->
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.18" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.18" />

    <!-- HTML sanitization (SEC-11) — Ganss.Xss (MIT), pinned to the version that fixes
         GHSA-j92c-7v7g-gj3f (template-tag sanitizer bypass); do not downgrade below 9.0.892.
         Bumped 9.0.892 -> 9.1.982 to resolve GHSA-pgww-w46g-26qg (CVE-2026-54570, mXSS via
         annotation-xml HTML integration point bypass): 9.0.892 hard-pinned its transitive
         AngleSharp dependency to exactly 0.17.1, which carries that advisory. Verified from
         the published nuspec that HtmlSanitizer >= 9.1.973 depends on AngleSharp >= 1.6.0
         (9.1.982 depends on AngleSharp 1.7.0), so upgrading the sanitizer itself resolves the
         transitive vulnerability without needing to override HtmlSanitizer's own pin. Do not
         downgrade below 9.1.973. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.1.982" />

    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.29" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />

    <!--
      R-BE-076 - transitive security pins. Central transitive pinning is on, so
      declaring these here forces the whole graph onto a non-vulnerable version.
      Each entry must cite the advisory it closes and the package that pulled the
      vulnerable version in, so the pin can be retired when the parent updates.
    -->
    <!-- GHSA-5crp-9r3c-p9vr (High) - pulled in by Hangfire.SqlServer 1.8.18 -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- GHSA-wvxc-855f-jvrv (Moderate) - pulled in by Microsoft.Identity.Web / Azure SDK -->
    <PackageVersion Include="Azure.Identity" Version="1.13.2" />
    <!-- GHSA-x674-v45j-fwxw (Low) - transitive of Azure.Identity -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.67.2" />

    <!-- Analyzers (root Directory.Build.props) -->
    <PackageVersion Include="Roslynator.Analyzers" Version="4.12.9" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" />
  </ItemGroup>
</Project>
