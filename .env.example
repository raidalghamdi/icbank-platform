# ─── ICBank Platform Environment ─────────────────────────────────────────────
# Copy this file to .env and fill in values. NEVER commit .env to git.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# Get from Supabase → Project Settings → Database → Connection string (URI)
# Use the **transaction pooler** URL for serverless friendliness.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ─── Supabase (for Storage + ACL table) ─────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>          # server-side only — keep secret
SUPABASE_STORAGE_BUCKET=icbank

# Logical paths inside the bucket. PRIVATE_OBJECT_DIR is prefixed onto every
# uploaded file's key. PUBLIC_OBJECT_SEARCH_PATHS lists folders that are safe
# to serve as public-read.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=public

# ─── AI Providers ───────────────────────────────────────────────────────────
# Gemini (free tier: 15 req/min, 1500 req/day) — primary AI engine.
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Perplexity ($5/mo free credit on Pro plan) — used by international-days web search.
# Create at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Optional Gemini model overrides
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# Optional: Azure AD SSO (leave blank to disable)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=

# ─── Internal API tokens ────────────────────────────────────────────────────
# Optional bearer token for /storage/objects/* endpoint
INTERNAL_STORAGE_TOKEN=
# Optional bearer token for /report endpoints
REPORT_API_KEY=

# ─── Frontend (internal-comms) ──────────────────────────────────────────────
# Base path under which the SPA is served (used by vite.config.ts)
BASE_PATH=/
# Backend API origin the frontend should call. In production, set this to the
# public Railway URL (e.g. https://icbank-api.up.railway.app).
VITE_API_BASE_URL=
